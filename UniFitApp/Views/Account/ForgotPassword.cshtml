@{
    ViewData["Title"] = "Забыли пароль?";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm p-4">
                <h3 class="text-center mb-4">Восстановление пароля</h3>
                <p class="text-muted text-center">Введите email, указанный при регистрации, и мы отправим вам ссылку для сброса.</p>
                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Ваш Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Отправить ссылку</button>
                </form>
            </div>
        </div>
    </div>
</div>