@{
    ViewData["Title"] = "Помощь";
}
<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Profile" class="text-decoration-none me-3" style="color: var(--text-main);">
            <i class="fas fa-chevron-left fa-lg"></i>
        </a>
        <h3 class="fw-bold mb-0" style="color: var(--text-main);">Поддержка</h3>
    </div>

    <div class="auth-card p-4">
        <div class="text-center mb-4">
            <i class="fas fa-life-ring fa-4x mb-3" style="color: var(--primary-orange); opacity: 0.8;"></i>
            <h5 class="fw-bold" style="color: var(--text-main);">Нужна помощь?</h5>
            <p style="color: var(--text-secondary);">Если у вас возникли вопросы или проблемы, свяжитесь с нашим администратором:</p>
        </div>

        <div class="d-flex align-items-center p-3 mb-3" style="background-color: #F7F7F7; border-radius: 12px; border: 1px solid var(--border-light);">
            <div class="me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 45px; height: 45px; background-color: #FFF3E0; color: var(--primary-orange);">
                <i class="fas fa-envelope"></i>
            </div>
            <div>
                <div class="small fw-bold" style="color: var(--text-secondary);">Email</div>
                <a href="mailto:support@unifit.kz" class="text-decoration-none fw-bold" style="color: var(--text-main);">support@unifit.kz</a>
            </div>
        </div>

        <div class="d-flex align-items-center p-3 mb-4" style="background-color: #F7F7F7; border-radius: 12px; border: 1px solid var(--border-light);">
            <div class="me-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 45px; height: 45px; background-color: #E8F5E9; color: #198754;">
                <i class="fas fa-phone-alt"></i>
            </div>
            <div>
                <div class="small fw-bold" style="color: var(--text-secondary);">Телефон</div>
                <a href="tel:+77771234567" class="text-decoration-none fw-bold" style="color: var(--text-main);">+7 (777) 123-45-67</a>
            </div>
        </div>

        <a asp-action="Profile" class="btn w-100 py-3 fw-bold" style="background-color: #F0F0F0; color: var(--text-main); border-radius: 16px;">Вернуться в профиль</a>
    </div>
</div>