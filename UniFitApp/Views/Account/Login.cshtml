@{
    ViewData["Title"] = "Вход в систему";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-12">
        <div class="auth-card p-4 mt-3">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1" style="color: var(--text-main);">С возвращением!</h2>
                <p style="color: var(--text-secondary);">Войдите в свой аккаунт UniFit</p>
            </div>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Email</label>
                    <input name="email" type="email" class="form-control" placeholder="student@university.com" required />
                </div>

                <div class="mb-4">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Пароль</label>
                    <input name="password" type="password" class="form-control" placeholder="******" required />
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm" style="background-color: var(--primary-orange); color: white; border-radius: 16px;">
                    Войти
                </button>
            </form>

            <div class="mt-4 text-center">
                <span style="color: var(--text-secondary);">Нет аккаунта?</span>
                <a asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--primary-orange);">Зарегистрироваться</a>
            </div>
        </div>
    </div>
</div>