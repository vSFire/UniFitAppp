@model IEnumerable<UniFitApp.Models.Notification>
@{
    ViewData["Title"] = "Уведомления";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Profile" class="text-decoration-none text-muted me-3">
            <i class="fas fa-chevron-left fa-lg"></i>
        </a>
        <h3 class="text-white fw-bold mb-0">Мои уведомления</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted mt-5">
            <i class="fas fa-bell-slash fa-3x mb-3"></i>
            <p>Новых уведомлений нет</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item bg-dark text-white border-secondary mb-2 rounded p-3">
                    <div class="d-flex w-100 justify-content-between">
                        <small class="text-warning">Системное сообщение</small>
                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("g")</small>
                    </div>
                    <p class="mb-1 mt-2">@item.Message</p>
                </div>
            }
        </div>
    }
</div>