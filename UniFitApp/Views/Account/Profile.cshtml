@using Microsoft.AspNetCore.Identity
@using UniFitApp.Models
@inject UserManager<AppUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    ViewData["Title"] = "Профиль";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-12">
        <div class="auth-card text-center pt-5 pb-5">

            <div class="mb-3 position-relative d-inline-block">
                @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
                {
                    <img src="@user.ProfilePictureUrl" alt="Avatar" class="rounded-circle shadow-sm"
                         style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--primary-orange);">
                }
                else
                {
                    <div style="width: 120px; height: 120px; background-color: #F0F0F0; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 3px solid var(--primary-orange);">
                        <span class="fw-bold fs-1" style="color: var(--text-main);">@user?.FirstName?.Substring(0, 1)</span>
                    </div>
                }
            </div>

            <h3 class="fw-bold mt-2 mb-1" style="color: var(--text-main);">@user?.FirstName @user?.LastName</h3>
            <p class="mb-3" style="color: var(--text-secondary);">@user?.Email</p>

            <div class="mb-4">
                @if (User.IsInRole("Admin"))
                {
                    <span class="badge px-3 py-2 rounded-pill shadow-sm" style="background-color: #FFEAE6; color: #D32F2F;">Админ</span>
                }
                else if (User.IsInRole("Coach"))
                {
                    <span class="badge px-3 py-2 rounded-pill shadow-sm" style="background-color: #FFF3E0; color: var(--primary-orange);">Тренер</span>
                }
                else
                {
                    <span class="badge px-3 py-2 rounded-pill shadow-sm" style="background-color: #E3F2FD; color: #1976D2;">Студент</span>
                }
            </div>

            <div class="list-group list-group-flush text-start rounded mb-4" style="border: 1px solid var(--border-light); overflow: hidden;">
                <a asp-action="Settings" class="list-group-item list-group-item-action p-3" style="background-color: var(--bg-card); color: var(--text-main); border-bottom: 1px solid var(--border-light);">
                    <i class="fas fa-cog me-3" style="width: 20px; color: var(--primary-orange);"></i> Настройки
                </a>
                <a asp-action="Notifications" class="list-group-item list-group-item-action p-3" style="background-color: var(--bg-card); color: var(--text-main); border-bottom: 1px solid var(--border-light);">
                    <i class="fas fa-bell me-3" style="width: 20px; color: var(--primary-orange);"></i> Уведомления
                </a>
                <a asp-action="Help" class="list-group-item list-group-item-action p-3" style="background-color: var(--bg-card); color: var(--text-main); border: none;">
                    <i class="fas fa-question-circle me-3" style="width: 20px; color: var(--primary-orange);"></i> Помощь
                </a>
            </div>

            <form asp-action="Logout" method="post">
                <button type="submit" class="btn w-100 py-3 fw-bold" style="background-color: #FFF0F0; color: #D32F2F; border: none; border-radius: 16px;">
                    <i class="fas fa-sign-out-alt me-2"></i> Выйти из аккаунта
                </button>
            </form>

        </div>
    </div>
</div>