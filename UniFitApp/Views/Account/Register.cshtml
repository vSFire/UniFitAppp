@{
    ViewData["Title"] = "Регистрация";
}

<style>
    /* Стили для красивого переключателя ролей */
    .role-btn-outline {
        color: var(--text-secondary);
        border: 1px solid var(--border-light);
        background-color: var(--bg-main);
        transition: all 0.2s;
    }

    .btn-check:checked + .role-btn-outline {
        background-color: #FFF3E0 !important;
        color: var(--primary-orange) !important;
        border-color: var(--primary-orange) !important;
        font-weight: bold;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-5 col-12">
        <div class="auth-card p-4 mt-4 mb-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1" style="color: var(--text-main);">Создать аккаунт</h2>
                <p style="color: var(--text-secondary);">Присоединяйтесь к UniFit</p>
            </div>

            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Имя</label>
                        <input name="firstName" class="form-control" placeholder="Иван" required />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Фамилия</label>
                        <input name="lastName" class="form-control" placeholder="Иванов" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Email</label>
                    <input name="email" type="email" class="form-control" placeholder="student@university.com" required />
                </div>

                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Пароль</label>
                    <input name="password" type="password" class="form-control" placeholder="******" required />
                </div>

                <div class="mb-4">
                    <label class="small fw-bold mb-2 d-block" style="color: var(--text-secondary);">Кто вы?</label>

                    <div class="btn-group w-100 shadow-sm" role="group" style="border-radius: 12px; overflow: hidden;">
                        <input type="radio" class="btn-check" name="userRole" id="roleStudent" value="Student" checked autocomplete="off">
                        <label class="btn role-btn-outline py-2" for="roleStudent">
                            <i class="fas fa-user-graduate me-2"></i>Студент
                        </label>

                        <input type="radio" class="btn-check" name="userRole" id="roleCoach" value="Coach" autocomplete="off">
                        <label class="btn role-btn-outline py-2" for="roleCoach">
                            <i class="fas fa-running me-2"></i>Тренер
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm" style="background-color: var(--primary-orange); color: white; border-radius: 16px;">
                    Зарегистрироваться
                </button>
            </form>

            <div class="mt-4 text-center">
                <span style="color: var(--text-secondary);">Уже есть аккаунт?</span>
                <a asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--primary-orange);">Войти</a>
            </div>
        </div>
    </div>
</div>