@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model UniFitApp.Models.AppUser

@{
    ViewData["Title"] = "Настройки";
    bool isCoach = await UserManager.IsInRoleAsync(Model, "Coach");
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Profile" class="text-decoration-none me-3" style="color: var(--text-main);">
        <i class="fas fa-chevron-left fa-lg"></i>
    </a>
    <h4 class="fw-bold mb-0" style="color: var(--text-main);">Редактировать профиль</h4>
</div>

<div class="auth-card">
    <form asp-action="Settings" method="post" enctype="multipart/form-data">

        <div class="text-center mb-4">
            <div class="position-relative d-inline-block">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid var(--primary-orange);">
                }
                else
                {
                    <div style="width: 100px; height: 100px; background-color: #F0F0F0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; border: 3px solid var(--primary-orange);">
                        <span class="fs-1 fw-bold" style="color: var(--text-main);">@Model.FirstName.Substring(0, 1)</span>
                    </div>
                }

                <label for="avatarUpload" class="position-absolute bottom-0 end-0 rounded-circle p-2 shadow-sm" style="cursor: pointer; background-color: #FFF3E0; color: var(--primary-orange); border: 2px solid white; transform: translate(10%, 10%);">
                    <i class="fas fa-camera"></i>
                </label>
                <input type="file" id="avatarUpload" name="avatarFile" class="d-none" accept="image/*">
            </div>
            <p class="small mt-3 fw-bold" style="color: var(--primary-orange);">Нажмите на иконку, чтобы изменить фотоo</p>
        </div>

        <div class="mb-3">
            <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Имя</label>
            <input asp-for="FirstName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Фамилия</label>
            <input asp-for="LastName" class="form-control" />
        </div>

        @if (isCoach)
        {
            <div class="mb-3">
                <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Специализация</label>
                <input asp-for="Specialization" class="form-control" placeholder="напрмиер Йога,Бокс..." />
            </div>

            <div class="mb-3">
                <label class="small fw-bold mb-1" style="color: var(--text-secondary);">О себе</label>
                <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Расскажите студентам о вашем опыте.."></textarea>
            </div>
        }

        <div class="mb-3">
            <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Номер телефона</label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="+7..." />
        </div>

        <button type="submit" class="btn w-100 py-3 fw-bold mt-3 shadow-sm" style="background-color: var(--primary-orange); color: white; border-radius: 16px;">Сохранить изменения</button>
    </form>
</div>
<div style="height: 80px;"></div>