@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model IEnumerable<UniFitApp.Models.AppUser>

@{
    ViewData["Title"] = "Все пользователи";
}

<div class="d-flex align-items-center mb-4">
    <h3 class="fw-bold mb-0" style="color: var(--text-main);"><i class="fas fa-users me-2" style="color: var(--primary-orange);"></i> Все пользователи</h3>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert text-danger border-0 mb-3 shadow-sm" style="background-color: #FFF0F0; border-radius: 12px; font-weight: bold;">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert text-success border-0 mb-3 shadow-sm" style="background-color: #E8F5E9; border-radius: 12px; font-weight: bold;">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
    </div>
}

<div class="card border-0 mb-4" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="border-radius: 16px; overflow: hidden; margin-bottom: 0;">
                <thead style="background-color: #F7F7F7;">
                    <tr>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Пользователь</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Почта</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Роль</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Дата регистрации</th>
                        <th class="p-3 fw-bold border-bottom-0 text-end" style="color: var(--text-secondary);">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roles = await UserManager.GetRolesAsync(user);
                        string userRole = roles.FirstOrDefault() ?? "No Role";

                        <tr style="border-bottom: 1px solid var(--border-light);">
                            <td class="p-3 align-middle" style="color: var(--text-main); font-weight: 500;">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" class="rounded-circle me-3 shadow-sm" style="width: 35px; height: 35px; object-fit:cover; border: 1px solid var(--border-light);">
                                    }
                                    else
                                    {
                                        <div class="rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold" style="width: 35px; height: 35px; background-color: #F0F0F0; color: var(--text-secondary); border: 1px solid var(--border-light);">
                                            @user.FirstName?.Substring(0, 1)
                                        </div>
                                    }
                                    @user.FirstName @user.LastName
                                </div>
                            </td>
                            <td class="p-3 align-middle" style="color: var(--text-secondary);">@user.Email</td>
                            <td class="p-3 align-middle">
                                @if (userRole == "Admin")
                                {
                                    <span class="badge px-2 py-1" style="background-color: #FFEAE6; color: #D32F2F;">@userRole</span>
                                }
                                else if (userRole == "Coach")
                                {
                                    <span class="badge px-2 py-1" style="background-color: #FFF3E0; color: var(--primary-orange);">@userRole</span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1" style="background-color: #E3F2FD; color: #1976D2;">@userRole</span>
                                }
                            </td>
                            <td class="p-3 align-middle" style="color: var(--text-secondary);">@user.CreatedAt.ToString("dd.MM.yyyy")</td>

                            <td class="p-3 align-middle text-end">
                                @if (user.Email != "admin@unifit.com")
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Вы уверены, что хотите удалить пользователя @user.Email?');">
                                        <button type="submit" class="btn btn-sm rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; background-color: #FFF0F0; color: #D32F2F; border: none;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div style="height: 80px;"></div>