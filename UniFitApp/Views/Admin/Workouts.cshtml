@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Все тренировки";
}

<div class="d-flex align-items-center mb-4">
    <h3 class="fw-bold mb-0" style="color: var(--text-main);"><i class="fas fa-list me-2" style="color: var(--primary-orange);"></i> Все тренировки зала</h3>
</div>

<div class="card border-0 mb-4" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="border-radius: 16px; overflow: hidden; margin-bottom: 0;">
                <thead style="background-color: #F7F7F7;">
                    <tr>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Дата и время</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Название и тип</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Тренер</th>
                        <th class="p-3 fw-bold border-bottom-0" style="color: var(--text-secondary);">Локация</th>
                        <th class="p-3 fw-bold border-bottom-0 text-center" style="color: var(--text-secondary);">Запись</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--border-light);">
                            <td class="p-3 align-middle">
                                <span class="d-block fw-bold" style="color: var(--text-main);">@w.StartTime.ToLocalTime().ToString("dd MMM yyyy")</span>
                                <small style="color: var(--text-secondary);"><i class="far fa-clock me-1"></i> @w.StartTime.ToLocalTime().ToString("HH:mm")</small>
                            </td>
                            <td class="p-3 align-middle">
                                <span class="fw-bold d-block mb-1" style="color: var(--text-main);">@w.Title</span>
                                <span class="badge px-2 py-1" style="background-color: #F0F0F0; color: var(--text-secondary);">@w.Type</span>
                            </td>
                            <td class="p-3 align-middle fw-bold" style="color: var(--primary-orange);">
                                <i class="fas fa-user-tie me-1"></i> @(w.Coach?.FirstName ?? "Удален")
                            </td>
                            <td class="p-3 align-middle" style="color: var(--text-secondary);">
                                <i class="fas fa-map-marker-alt me-1"></i> @w.Location
                            </td>
                            <td class="p-3 align-middle text-center fw-bold">
                                @if (w.Enrollments.Count >= w.Capacity)
                                {
                                    <span style="color: #D32F2F;">@w.Enrollments.Count / @w.Capacity (Full)</span>
                                }
                                else
                                {
                                    <span style="color: #198754;">@w.Enrollments.Count / @w.Capacity</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div style="height: 80px;"></div>