@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Все тренировки";
    var currentUser = await UserManager.GetUserAsync(User);

    // Получаем текущее состояние фильтра из контроллера (по умолчанию true - "Все")
    var showAll = ViewBag.ShowAll as bool? ?? true;
}

<div class="d-flex align-items-center mb-4">
    <h4 class="fw-bold text-white mb-0">Gym Schedule</h4>
</div>

<div class="d-flex gap-2 mb-4 overflow-auto">
    <a asp-action="AllWorkouts" asp-route-showAll="true"
       class="btn btn-sm rounded-pill px-3 fw-bold @(showAll ? "btn-warning text-dark" : "btn-dark text-muted border border-secondary")">
        All Classes
    </a>

    <a asp-action="AllWorkouts" asp-route-showAll="false"
       class="btn btn-sm rounded-pill px-3 fw-bold @(!showAll ? "btn-warning text-dark" : "btn-dark text-muted border border-secondary")">
        My Classes
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <p>Тренировки не найдены.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        bool isMyClass = item.CoachId == currentUser.Id;

        <div class="card mb-3 border-0" style="background-color: #1E1E1E; border-radius: 15px; border-left: 4px solid @(isMyClass ? "var(--primary-orange)" : "#6c757d");">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted mb-1">
                            @item.StartTime.ToLocalTime().ToString("dd MMM HH:mm")
                        </div>

                        <h5 class="card-title text-white fw-bold mb-1">@item.Title</h5>

                        <div class="small @(isMyClass ? "text-warning" : "text-muted") mb-2 d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(item.Coach?.ProfilePictureUrl))
                            {
                                <img src="@item.Coach.ProfilePictureUrl"
                                     alt="Coach"
                                     class="rounded-circle me-2"
                                     style="width: 24px; height: 24px; object-fit: cover; border: 1px solid @(isMyClass ? "var(--primary-orange)" : "#6c757d");">
                            }
                            else
                            {
                                <i class="fas fa-user-circle me-2"></i>
                            }
                            <span>@(isMyClass ? "You" : $"Coach {item.Coach?.FirstName}")</span>
                        </div>
                    </div>

                    <div class="text-end">
                        <span class="badge bg-dark border border-secondary text-muted mb-3">
                            @item.Enrollments.Count / @item.Capacity
                        </span>
                    </div>
                </div>

                <div class="mt-2">
                    @if (isMyClass)
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning btn-sm w-100 fw-bold" style="border-radius: 10px;">
                            Manage Class
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-dark btn-sm w-100 text-muted border border-secondary" disabled style="border-radius: 10px;">
                            View Only
                        </button>
                    }
                </div>

            </div>
        </div>
    }
}
<div style="height: 80px;"></div>