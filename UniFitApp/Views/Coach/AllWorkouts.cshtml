@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Все тренировки";
    var currentUser = await UserManager.GetUserAsync(User);
    var showAll = ViewBag.ShowAll as bool? ?? true;
}

<div class="d-flex align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color: var(--text-main); font-size: 28px;">Расписание занятий</h4>
</div>

<div class="d-flex mb-4 p-1" style="background-color: #EBEBEB; border-radius: 12px; max-width: 300px;">
    <a asp-action="AllWorkouts" asp-route-showAll="true"
       class="flex-fill btn btn-sm rounded fw-bold"
       style="background-color: @(showAll ? "var(--bg-card)" : "transparent");
              color: @(showAll ? "var(--text-main)" : "var(--text-secondary)");
              box-shadow: @(showAll ? "0 2px 5px rgba(0,0,0,0.05)" : "none"); border: none;">
        Все тренировки
    </a>
    <a asp-action="AllWorkouts" asp-route-showAll="false"
       class="flex-fill btn btn-sm rounded fw-bold"
       style="background-color: @(!showAll ? "var(--bg-card)" : "transparent");
              color: @(!showAll ? "var(--text-main)" : "var(--text-secondary)");
              box-shadow: @(!showAll ? "0 2px 5px rgba(0,0,0,0.05)" : "none"); border: none;">
        Мои тренировки
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5" style="color: var(--text-secondary);">
        <i class="fas fa-calendar-times fa-3x mb-3" style="opacity: 0.3;"></i>
        <p>Тренировки не найдены.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        bool isMyClass = item.CoachId == currentUser.Id;

        <div class="card mb-3 border-0" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light); border-left: 4px solid @(isMyClass ? "var(--primary-orange)" : "#D1D1D1") !important;">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small mb-1 fw-bold" style="color: var(--text-secondary);">
                            <i class="far fa-clock me-1"></i> @item.StartTime.ToLocalTime().ToString("dd MMM HH:mm")
                        </div>

                        <h5 class="card-title fw-bold mb-2" style="color: var(--text-main);">@item.Title</h5>

                        <div class="small d-flex align-items-center" style="color: @(isMyClass ? "var(--primary-orange)" : "var(--text-secondary)"); font-weight: @(isMyClass ? "bold" : "normal");">
                            @if (!string.IsNullOrEmpty(item.Coach?.ProfilePictureUrl))
                            {
                                <img src="@item.Coach.ProfilePictureUrl"
                                     alt="Coach"
                                     class="rounded-circle me-2"
                                     style="width: 24px; height: 24px; object-fit: cover; border: 1px solid @(isMyClass ? "var(--primary-orange)" : "var(--border-light)");">
                            }
                            else
                            {
                                <i class="fas fa-user-circle me-2 fs-5"></i>
                            }
                            <span>@(isMyClass ? "Вы" : $"Тренер {item.Coach?.FirstName}")</span>
                        </div>
                    </div>

                    <div class="text-end">
                        <span class="badge fw-normal" style="background-color: #F0F0F0; color: var(--text-main); font-size: 12px; padding: 6px 10px;">
                            <i class="fas fa-users me-1" style="color: var(--text-secondary);"></i> @item.Enrollments.Count / @item.Capacity
                        </span>
                    </div>
                </div>

                <div class="mt-3">
                    @if (isMyClass)
                    {
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm w-100 fw-bold py-2" style="background-color: #FFF3E0; color: var(--primary-orange); border: none; border-radius: 10px;">
                            Управление занятием
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm w-100 fw-bold py-2" disabled style="background-color: #F0F0F0; color: #A0A0A0; border: none; border-radius: 10px;">
                            <i class="fas fa-lock me-1"></i> Только просмотр
                        </button>
                    }
                </div>

            </div>
        </div>
    }
}
<div style="height: 80px;"></div>