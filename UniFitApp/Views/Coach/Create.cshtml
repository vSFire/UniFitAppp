@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Новая тренировка";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted me-3">
                <i class="fas fa-chevron-left fa-lg"></i>
            </a>
            <h3 class="fw-bold mb-0 text-white">Create New Class</h3>
        </div>

        <div class="auth-card">
            <form asp-action="Create">
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label class="text-muted small">Class Name</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. HIIT Intensity Training" />
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Select Date & Time</label>
                    <input asp-for="StartTime" class="form-control" type="datetime-local" />
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="text-muted small">Capacity</label>
                        <input asp-for="Capacity" class="form-control" type="number" value="20" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="text-muted small">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Studio B" />
                    </div>
                </div>

                <div class="mb-3 p-3 border border-secondary rounded text-center" style="border-style: dashed !important;">
                    <i class="fas fa-video text-warning mb-2"></i>
                    <p class="small text-muted mb-2">Upload Technique Video (URL)</p>
                    <input asp-for="VideoUrl" class="form-control form-control-sm" placeholder="https://youtube.com/..." />
                </div>

                <div class="mb-4">
                    <label class="text-muted small">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly describe what students will learn..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">Publish Class</button>
            </form>
        </div>

    </div>
</div>