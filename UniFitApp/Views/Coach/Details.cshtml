@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Участники";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="text-decoration-none me-3" style="color: var(--text-main);">
            <i class="fas fa-chevron-left fa-lg"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0" style="color: var(--text-main); font-size: 24px;">Attendance</h4>
            <small style="color: var(--text-secondary);">Class: @Model.Title</small>
        </div>
    </div>
    <div style="color: var(--text-main);">
        <i class="fas fa-search"></i>
    </div>
</div>

<div class="mb-4 text-center p-4" style="background-color: var(--bg-card); border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
    <h2 class="fw-bold mb-0" style="color: var(--text-main);">@Model.Enrollments.Count <small class="fw-normal" style="color: var(--text-secondary); font-size: 16px;">Students Registered</small></h2>

    <button class="btn w-100 fw-bold mt-3" style="background-color: #FFF3E0; color: var(--primary-orange); border-radius: 12px; padding: 12px; border: none;">
        <i class="fas fa-bell me-2"></i> Notify All Students
    </button>
</div>

<div class="d-flex flex-column gap-3">
    @if (!Model.Enrollments.Any())
    {
        <div class="text-center py-5" style="color: var(--text-secondary);">
            <i class="fas fa-user-friends fa-3x mb-3" style="opacity: 0.3"></i>
            <p>Пока никто не записался.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model.Enrollments)
        {
            <div class="d-flex align-items-center p-3" style="background-color: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-light); box-shadow: 0 2px 8px rgba(0,0,0,0.02); border-left: 5px solid @(item.IsPresent ? "#198754" : "var(--border-light)") !important;">
                <div class="me-3">
                    @if (!string.IsNullOrEmpty(item.Student.ProfilePictureUrl))
                    {
                        <img src="@item.Student.ProfilePictureUrl"
                             alt="Student"
                             class="rounded-circle"
                             style="width: 50px; height: 50px; object-fit: cover; border: 1px solid var(--border-light);">
                    }
                    else
                    {
                        <div style="width: 50px; height: 50px; background-color: #F0F0F0; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-light);">
                            <span class="fw-bold" style="color: var(--text-main);">@item.Student.FirstName.Substring(0, 1)</span>
                        </div>
                    }
                </div>

                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-0" style="color: var(--text-main);">@item.Student.FirstName @item.Student.LastName</h6>

                    <div class="d-flex align-items-center mt-1">
                        @if (item.IsPresent)
                        {
                            <small class="text-success fw-bold me-2"><i class="fas fa-check-circle"></i> Present</small>
                        }
                        else
                        {
                            <small class="me-2" style="color: var(--text-secondary);">Not marked yet</small>
                        }

                        <a asp-action="SendMessage" asp-route-studentId="@item.StudentId" class="text-decoration-none ms-2" style="color: var(--primary-orange);" title="Написать сообщение">
                            <i class="fas fa-envelope"></i>
                        </a>
                    </div>
                </div>

                <div class="ms-auto">
                    <form asp-action="ToggleAttendance" asp-route-enrollmentId="@item.Id" method="post">
                        @if (item.IsPresent)
                        {
                            <button type="submit" class="btn btn-sm rounded-circle shadow-sm" style="width: 40px; height: 40px; background-color: #F0F0F0; color: var(--text-main); border: none;">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm rounded-circle shadow-sm" style="width: 40px; height: 40px; background-color: #E8F5E9; color: #198754; border: none;">
                                <i class="fas fa-check"></i>
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    }
</div>

<div class="mt-5 pt-4" style="border-top: 1px solid var(--border-light);">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn w-100 mb-3 fw-bold py-3" style="background-color: var(--bg-card); color: var(--primary-orange); border: 2px solid var(--primary-orange); border-radius: 16px;">
        <i class="fas fa-edit me-2"></i> Edit Class Details
    </a>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Вы уверены? Это удалит тренировку и все записи.');">
        <button type="submit" class="btn w-100 fw-bold py-3" style="background-color: #FFF0F0; color: #D32F2F; border: none; border-radius: 16px;">
            <i class="fas fa-trash me-2"></i> Delete This Class
        </button>
    </form>
</div>
<div style="height: 80px;"></div>