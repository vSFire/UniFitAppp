@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Участники";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted me-3">
        <i class="fas fa-chevron-left fa-lg"></i>
    </a>
    <div>
        <h4 class="fw-bold text-white mb-0">Attendance</h4>
        <small class="text-muted">Class: @Model.Title</small>
    </div>
    <div class="ms-auto">
        <i class="fas fa-search text-white"></i>
    </div>
</div>

<div class="mb-4 text-center">
    <h2 class="text-white fw-bold">@Model.Enrollments.Count <small class="text-muted fs-6">Students Registered</small></h2>

    <button class="btn btn-warning w-100 fw-bold mt-2" style="border-radius: 12px; padding: 12px;">
        <i class="fas fa-bell me-2"></i> Notify All Students
    </button>
</div>

<div class="d-flex flex-column gap-3">
    @if (!Model.Enrollments.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="fas fa-user-friends fa-3x mb-3" style="opacity: 0.3"></i>
            <p>Пока никто не записался.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model.Enrollments)
        {
            <div class="d-flex align-items-center p-3 rounded mb-2" style="background-color: #1E1E1E; border-left: 5px solid @(item.IsPresent ? "#198754" : "#333");">
                <div class="me-3">
                    @if (!string.IsNullOrEmpty(item.Student.ProfilePictureUrl))
                    {
                        <img src="@item.Student.ProfilePictureUrl"
                             alt="Student"
                             class="rounded-circle"
                             style="width: 50px; height: 50px; object-fit: cover; border: 1px solid var(--primary-orange);">
                    }
                    else
                    {
                        <div style="width: 50px; height: 50px; background-color: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid var(--primary-orange);">
                            <span class="text-white fw-bold">@item.Student.FirstName.Substring(0, 1)</span>
                        </div>
                    }
                </div>

                <div class="flex-grow-1">
                    <h6 class="text-white fw-bold mb-0">@item.Student.FirstName @item.Student.LastName</h6>

                    <div class="d-flex align-items-center">
                        @if (item.IsPresent)
                        {
                            <small class="text-success me-2"><i class="fas fa-check-circle"></i> Present</small>
                        }
                        else
                        {
                            <small class="text-muted me-2">Not marked yet</small>
                        }

                        <a asp-action="SendMessage" asp-route-studentId="@item.StudentId" class="text-decoration-none text-info ms-2" title="Написать сообщение">
                            <i class="fas fa-envelope"></i>
                        </a>
                    </div>
                </div>

                <div class="ms-auto">
                    <form asp-action="ToggleAttendance" asp-route-enrollmentId="@item.Id" method="post">
                        @if (item.IsPresent)
                        {
                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 40px; height: 40px;">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success btn-sm rounded-circle" style="width: 40px; height: 40px;">
                                <i class="fas fa-check"></i>
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    }
</div>

<div class="mt-5 pt-3 border-top border-secondary">

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning w-100 mb-3">
        <i class="fas fa-edit me-2"></i> Edit Class Details
    </a>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Вы уверены? Это удалит тренировку и все записи.');">
        <button type="submit" class="btn btn-outline-danger w-100">
            <i class="fas fa-trash me-2"></i> Delete This Class
        </button>
    </form>
</div>