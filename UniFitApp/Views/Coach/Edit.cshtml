@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Редактирование";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted me-3">
                <i class="fas fa-chevron-left fa-lg"></i>
            </a>
            <h3 class="fw-bold mb-0 text-white">Edit Class</h3>
        </div>

        <div class="auth-card">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label class="text-muted small">Class Name</label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Workout Type</label>
                    <select asp-for="Type" class="form-select bg-dark text-white border-secondary">
                        <option value="General">General (Общая)</option>
                        <option value="Cardio">Cardio (Кардио)</option>
                        <option value="Strength">Strength (Силовая)</option>
                        <option value="Yoga">Yoga/Pilates (Йога)</option>
                        <option value="Boxing">Boxing (Бокс)</option>
                        <option value="CrossFit">CrossFit</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Date & Time</label>
                    <input asp-for="StartTime" class="form-control" type="datetime-local" />
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="text-muted small">Capacity</label>
                        <input asp-for="Capacity" class="form-control" type="number" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="text-muted small">Location</label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 p-3 border border-secondary rounded text-center" style="border-style: dashed !important; background-color: #2b2b2b;">
                    <i class="fab fa-youtube text-danger fa-2x mb-2"></i>
                    <p class="small text-muted mb-2">Update Video Link</p>
                    <input asp-for="VideoUrl" class="form-control form-control-sm text-center" />
                </div>

                <div class="mb-4">
                    <label class="text-muted small">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-warning w-100 py-3 fw-bold">Save Changes</button>
            </form>
        </div>
    </div>
</div>