@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Редактирование";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="text-decoration-none me-3" style="color: var(--text-main);">
                <i class="fas fa-chevron-left fa-lg"></i>
            </a>
            <h3 class="fw-bold mb-0" style="color: var(--text-main);">Edit Class</h3>
        </div>

        <div class="auth-card">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Class Name</label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Workout Type</label>
                    <select asp-for="Type" class="form-select" style="background-color: var(--bg-main); border: 1px solid var(--border-light); color: var(--text-main); border-radius: 12px; padding: 12px;">
                        <option value="General">General (Общая)</option>
                        <option value="Cardio">Cardio (Кардио)</option>
                        <option value="Strength">Strength (Силовая)</option>
                        <option value="Yoga">Yoga/Pilates (Йога)</option>
                        <option value="Boxing">Boxing (Бокс)</option>
                        <option value="CrossFit">CrossFit</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Date & Time</label>
                    <input asp-for="StartTime" class="form-control" type="datetime-local" />
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Capacity</label>
                        <input asp-for="Capacity" class="form-control" type="number" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Location</label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 p-3 rounded text-center" style="border: 1px dashed var(--primary-orange); background-color: #FFF3E0;">
                    <i class="fab fa-youtube fa-2x mb-2" style="color: var(--primary-orange);"></i>
                    <p class="small fw-bold mb-2" style="color: var(--primary-orange);">Update Video Link</p>
                    <input asp-for="VideoUrl" class="form-control form-control-sm text-center bg-white" style="border-color: var(--border-light); color: var(--text-main);" />
                </div>

                <div class="mb-4">
                    <label class="small fw-bold mb-1" style="color: var(--text-secondary);">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm" style="background-color: var(--primary-orange); color: white; border-radius: 16px;">Save Changes</button>
            </form>
        </div>
    </div>
</div>
<div style="height: 80px;"></div>