@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Дашборд тренера";
    // Считаем простую статистику для красоты
    int totalStudents = Model.Sum(w => w.Enrollments.Count);
    int activeHours = Model.Count();
}

<div class="d-flex align-items-center mb-4">
    <div class="me-3">
        <div style="width: 50px; height: 50px; background-color: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid var(--primary-orange);">
            <i class="fas fa-user text-white"></i>
        </div>
    </div>
    <div>
        <h4 class="fw-bold text-white mb-0">Coach Control Center</h4>
        <small class="text-muted">University Gym Admin</small>
    </div>
    <div class="ms-auto">
        <i class="fas fa-bell text-white"></i>
    </div>
</div>

<div class="row mb-4">
    <div class="col-6">
        <div class="p-3 rounded" style="background-color: #1E1E1E;">
            <small class="text-muted text-uppercase" style="font-size: 10px;"><i class="fas fa-users me-1"></i> Today's Total</small>
            <h2 class="fw-bold text-white mt-1">@totalStudents</h2>
            <small class="text-muted">students</small>
        </div>
    </div>
    <div class="col-6">
        <div class="p-3 rounded" style="background-color: #1E1E1E;">
            <small class="text-muted text-uppercase" style="font-size: 10px;"><i class="fas fa-clock me-1"></i> Active Hours</small>
            <h2 class="fw-bold text-white mt-1">@activeHours</h2>
            <small class="text-muted">hours</small>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="text-white fw-bold">My Schedule</h5>
    <a href="#" class="text-warning small text-decoration-none">View All</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <p>У вас пока нет тренировок.</p>
        <p>Нажмите "+" внизу, чтобы создать.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        // Вычисляем процент заполненности для полоски
        int percent = (item.Capacity > 0) ? (item.Enrollments.Count * 100 / item.Capacity) : 0;
        string statusColor = percent >= 100 ? "text-danger" : "text-success";
        string statusText = percent >= 100 ? "FULL" : "REGISTERED";

        <div class="card mb-3 border-0" style="background-color: #1E1E1E; border-radius: 15px;">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-2">
                    <small class="@statusColor fw-bold" style="font-size: 10px;">
                        ● @item.Enrollments.Count / @item.Capacity @statusText
                    </small>
                    <div style="width: 40px; height: 40px; background-color: #333; border-radius: 8px;"></div>
                </div>

                <h5 class="card-title text-white fw-bold mb-1">@item.Title</h5>

                <div class="text-muted small mb-3">
                    <i class="far fa-clock me-1"></i>
                    @item.StartTime.ToString("HH:mm") - @item.StartTime.AddMinutes(60).ToString("HH:mm")
                </div>

                <div class="progress mb-3" style="height: 4px; background-color: #333;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @percent%"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex">
                        <div class="rounded-circle bg-secondary border border-dark" style="width:25px; height:25px;"></div>
                        <div class="rounded-circle bg-secondary border border-dark ms-n2" style="width:25px; height:25px; margin-left: -10px;"></div>
                        <div class="rounded-circle bg-secondary border border-dark ms-n2" style="width:25px; height:25px; margin-left: -10px;"></div>
                    </div>

                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning btn-sm fw-bold px-3" style="border-radius: 20px;">
                        Manage <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </div>

            </div>
        </div>
    }
}
<div style="height: 80px;"></div>