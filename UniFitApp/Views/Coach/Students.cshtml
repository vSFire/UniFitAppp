@model IEnumerable<UniFitApp.Models.AppUser>

@{
    ViewData["Title"] = "Студенты";
}

<div class="d-flex align-items-center mb-4">
    <h4 class="fw-bold text-white mb-0">All Students</h4>
    <span class="badge bg-warning text-dark ms-3">@Model.Count() Total</span>
</div>

<div class="mb-4">
    <input type="text" class="form-control" placeholder="Search student by name..." style="background: #1E1E1E; border: none;">
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <p>В системе пока нет студентов.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var student in Model)
        {
            <div class="d-flex align-items-center p-3 rounded" style="background-color: #1E1E1E;">
                <div class="me-3">
                    @if (!string.IsNullOrEmpty(student.ProfilePictureUrl))
                    {
                        <img src="@student.ProfilePictureUrl"
                             alt="Student"
                             class="rounded-circle"
                             style="width: 50px; height: 50px; object-fit: cover; border: 1px solid #444;">
                    }
                    else
                    {
                        <div style="width: 50px; height: 50px; background-color: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid #444;">
                            <span class="text-white fw-bold">@student.FirstName.Substring(0, 1)</span>
                        </div>
                    }
                </div>

                <div class="flex-grow-1">
                    <h6 class="text-white fw-bold mb-0">@student.FirstName @student.LastName</h6>
                    <small class="text-muted">@student.Email</small>
                </div>

                <div>
                    <a asp-action="SendMessage" asp-route-studentId="@student.Id" class="btn btn-outline-info btn-sm rounded-circle me-2" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="fas fa-envelope"></i>
                    </a>

                    <a href="mailto:@student.Email" class="btn btn-dark btn-sm rounded-circle" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="fas fa-envelope text-warning"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}