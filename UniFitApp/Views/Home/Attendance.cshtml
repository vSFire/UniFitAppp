@model UniFitApp.Models.AppUser

@{
    ViewData["Title"] = "Мой пропуск";
}

<div class="d-flex align-items-center mb-4">
    <h4 class="fw-bold text-white mb-0">Member Pass</h4>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-md-6 col-12">

        <div class="card border-0 text-center text-white" style="background: linear-gradient(145deg, #1E1E1E, #121212); border-radius: 25px; border: 1px solid #333;">
            <div class="card-body p-4">

                <div class="mb-3 text-warning">
                    <i class="fas fa-dumbbell fa-2x"></i>
                    <div class="small fw-bold tracking-widest">UNIFIT ACCESS</div>
                </div>

                <div class="mb-3">
                    <div style="width: 100px; height: 100px; border-radius: 50%; border: 3px solid var(--primary-orange); margin: 0 auto; display: flex; align-items: center; justify-content: center; background-color: #000;">
                        <span class="fs-1 fw-bold text-white">@Model.FirstName.Substring(0, 1)</span>
                    </div>
                </div>

                <h3 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h3>
                <p class="text-muted small">@Model.Email</p>

                <span class="badge bg-success px-3 py-2 rounded-pill mb-4">ACTIVE MEMBER</span>

                <div class="bg-white p-3 rounded mb-3 mx-auto" style="width: fit-content;">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@Model.Email" alt="QR Code" style="width: 150px; height: 150px;" />
                </div>

                <p class="text-muted" style="font-size: 10px;">
                    Scan this code at the gym entrance terminal.<br>
                    ID: @Model.Id.Substring(0, 8).ToUpper()
                </p>

            </div>
        </div>

        <div class="row mt-4 g-2">
            <div class="col-6">
                <div class="p-3 rounded text-center" style="background-color: #1E1E1E;">
                    <h2 class="fw-bold text-warning mb-0">12</h2>
                    <small class="text-muted" style="font-size: 10px;">Visits this month</small>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 rounded text-center" style="background-color: #1E1E1E;">
                    <h2 class="fw-bold text-warning mb-0">98%</h2>
                    <small class="text-muted" style="font-size: 10px;">Attendance Rate</small>
                </div>
            </div>
        </div>

    </div>
</div>

<div style="height: 80px;"></div>