@model UniFitApp.Models.AppUser

@{
    ViewData["Title"] = $"Тренер {Model.FirstName}";
    var workouts = ViewBag.Workouts as List<UniFitApp.Models.Workout> ?? new List<UniFitApp.Models.Workout>();
}

<div class="container mt-2">

    <div class="mb-4">
        <a href="javascript:history.back()" class="text-decoration-none" style="color: var(--text-secondary); font-weight: bold;">
            <i class="fas fa-arrow-left me-2"></i> Назад
        </a>
    </div>

    <div class="text-center mb-5">
        <div class="position-relative d-inline-block mb-3">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" class="rounded-circle shadow-sm"
                     style="width: 120px; height: 120px; object-fit: cover; border: 3px solid var(--primary-orange) !important;">
            }
            else
            {
                <div style="width: 120px; height: 120px; background-color: #F0F0F0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; border: 3px solid var(--primary-orange);">
                    <span class="display-4 fw-bold" style="color: var(--text-main);">@Model.FirstName.Substring(0, 1)</span>
                </div>
            }
        </div>

        <h2 class="fw-bold mb-1" style="color: var(--text-main);">@Model.FirstName @Model.LastName</h2>

        @if (!string.IsNullOrEmpty(Model.Specialization))
        {
            <span class="badge mb-3 px-3 py-2" style="background-color: #FFF3E0; color: var(--primary-orange); border-radius: 10px;">@Model.Specialization</span>
        }
        else
        {
            <span class="badge mb-3 px-3 py-2" style="background-color: #F0F0F0; color: var(--text-secondary); border-radius: 10px;">Тренер</span>
        }

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="mx-auto" style="max-width: 500px; color: var(--text-secondary); line-height: 1.6;">@Model.Bio</p>
        }
    </div>

    <h5 class="fw-bold mb-3 pb-2" style="color: var(--text-main); border-bottom: 1px solid var(--border-light);">Предстоящие занятия</h5>

    @if (workouts.Any())
    {
        <div class="row">
            @foreach (var item in workouts)
            {
                <div class="col-md-6 mb-3">
                    <div class="card border-0 h-100" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light); border-left: 4px solid var(--primary-orange) !important;">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--text-main);">@item.Title</h6>
                                <small class="d-block mb-1" style="color: var(--text-secondary);">
                                    <i class="far fa-calendar me-1"></i> @item.StartTime.ToLocalTime().ToString("dd MMM, HH:mm")
                                </small>
                                <small style="color: var(--text-secondary);">
                                    <i class="fas fa-map-marker-alt me-1"></i> @item.Location
                                </small>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm rounded-pill px-3 fw-bold" style="background-color: #F0F0F0; color: var(--text-main); border: none;">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4" style="color: var(--text-secondary);">
            <i class="fas fa-calendar-times fa-2x mb-2" style="opacity: 0.3;"></i>
            <p>Нет запланированных занятий.</p>
        </div>
    }
</div>
<div style="height: 60px;"></div>