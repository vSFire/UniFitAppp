@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Details";
    string currentUserId = ViewBag.CurrentUserId as string;
    bool isBooked = Model.Enrollments.Any(e => e.StudentId == currentUserId);
    int spotsLeft = Model.Capacity - Model.Enrollments.Count;
    var futureSessions = ViewBag.FutureSessions as List<UniFitApp.Models.Workout> ?? new List<UniFitApp.Models.Workout>();

    string videoId = "";
    if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        if (Model.VideoUrl.Contains("youtu.be/"))
        {
            videoId = Model.VideoUrl.Split("youtu.be/")[1].Split("?")[0];
        }
        else if (Model.VideoUrl.Contains("v="))
        {
            videoId = Model.VideoUrl.Split("v=")[1].Split("&")[0];
        }
    }
}

<div class="container pb-5">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="text-decoration-none me-3" style="color: var(--text-main);">
            <i class="fas fa-arrow-left fa-lg"></i>
        </a>
        <h4 class="fw-bold mb-0" style="color: var(--text-main);">Class Details</h4>
    </div>

    @if (!string.IsNullOrEmpty(videoId))
    {
        <div class="ratio ratio-16x9 mb-4 rounded overflow-hidden shadow-sm border-0 d-none d-md-block">
            <iframe src="https://www.youtube.com/embed/@videoId?rel=0"
                    title="YouTube video"
                    allowfullscreen></iframe>
        </div>
    }
    else
    {
        <div class="mb-4 rounded d-none d-md-flex align-items-center justify-content-center"
             style="height: 200px; background-color: #EBEBEB; color: var(--text-secondary); border: 1px dashed var(--border-light);">
            <div class="text-center">
                <i class="fas fa-video-slash fa-2x mb-2" style="opacity: 0.5;"></i>
                <p class="small mb-0 fw-bold">No preview video available</p>
            </div>
        </div>
    }

    <div class="card border-0 mb-4" style="background-color: var(--bg-card); border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid var(--border-light) !important;">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-1" style="color: var(--text-main);">@Model.Title</h2>

            <p class="mb-4" style="line-height: 1.6; color: var(--text-secondary);">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided by the coach." : Model.Description)
            </p>

            @if (!string.IsNullOrEmpty(videoId))
            {
                <button type="button" class="btn btn-sm rounded-pill mb-4 px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#videoModal" style="background-color: #FFF3E0; color: var(--primary-orange); border: none;">
                    <i class="fas fa-play-circle me-1"></i> Посмотреть видеогид
                </button>

                <div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-white border-0 shadow-lg">
                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div class="ratio ratio-16x9">
                                    <iframe src="https://www.youtube.com/embed/@videoId?rel=0" allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-4 pt-3" style="border-top: 1px solid var(--border-light);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" style="color: var(--text-main);">Доступное время</h6>
                    <span class="badge fw-normal" style="background-color: #F0F0F0; color: var(--text-secondary);">Все тренеры</span>
                </div>

                @if (futureSessions.Any())
                {
                    var groupedSessions = futureSessions.GroupBy(s => s.StartTime.Date);

                    foreach (var dayGroup in groupedSessions)
                    {
                        string dayHeader = "";
                        if (dayGroup.Key == DateTime.UtcNow.Date) dayHeader = $"Сегодня, {dayGroup.Key.ToString("dd MMMM")}";
                        else if (dayGroup.Key == DateTime.UtcNow.Date.AddDays(1)) dayHeader = $"Завтра, {dayGroup.Key.ToString("dd MMMM")}";
                        else dayHeader = dayGroup.Key.ToString("dd MMMM, dddd");

                        <div class="mb-3">
                            <div class="small fw-bold mb-2" style="color: var(--text-secondary);">@dayHeader</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var session in dayGroup)
                                {
                                    bool isSessionBooked = session.Enrollments.Any(e => e.StudentId == currentUserId);
                                    bool isSessionFull = (session.Capacity - session.Enrollments.Count) <= 0;

                                    string btnStyle = session.Id == Model.Id ? "background-color: #FFF3E0; color: var(--primary-orange); border: 1px solid var(--primary-orange); font-weight: bold;" : "background-color: #F0F0F0; color: var(--text-main); border: 1px solid transparent; font-weight: 500;";

                                    if (isSessionBooked && session.Id != Model.Id) btnStyle = "background-color: #FFF3E0; color: var(--primary-orange); opacity: 0.7; border: none; font-weight: bold;";
                                    else if (isSessionFull && session.Id != Model.Id) btnStyle = "background-color: #F0F0F0; color: #A0A0A0; opacity: 0.5; border: none; pointer-events: none;";

                                    <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm rounded-pill px-3 py-2" style="font-size: 14px; min-width: 75px; @btnStyle">
                                        @session.StartTime.ToLocalTime().ToString("HH:mm")
                                        @if (isSessionBooked)
                                        {
                                            <i class="fas fa-check ms-1" style="font-size: 10px;"></i>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="small mb-0" style="color: var(--text-secondary);">Нет других доступных сеансов.</p>
                }
            </div>

            <hr style="border-color: var(--border-light); opacity: 1;">

            <hr style="border-color: var(--border-light); opacity: 1;">

            <div class="row g-3 mb-2">
                <div class="col-6">
                    <small class="d-block mb-2" style="color: var(--text-secondary);">Coach</small>
                    @if (Model.Coach != null)
                    {
                        <a asp-action="CoachProfile" asp-route-coachId="@Model.CoachId" class="text-decoration-none d-inline-flex align-items-center px-2 py-1" style="background-color: #FFF3E0; color: var(--primary-orange); border-radius: 8px; font-weight: bold; border: 1px solid rgba(255, 94, 0, 0.2);">
                            <i class="fas fa-user-circle me-2 fs-6"></i>
                            <span>@Model.Coach.FirstName</span>
                            <i class="fas fa-chevron-right ms-2" style="font-size: 10px;"></i>
                        </a>
                    }
                    else
                    {
                        <span class="fw-bold" style="color: var(--text-main);">
                            <i class="fas fa-user me-1" style="color: var(--primary-orange);"></i> Unknown
                        </span>
                    }
                </div>
                <div class="col-6">
                    <small class="d-block mb-1" style="color: var(--text-secondary);">Location</small>
                    <span class="fw-bold" style="color: var(--text-main);"><i class="fas fa-map-pin me-1" style="color: var(--primary-orange);"></i> @Model.Location</span>
                </div>
                <div class="col-6">
                    <small class="d-block mb-1" style="color: var(--text-secondary);">Spots Left</small>
                    <span class="fw-bold @(spotsLeft > 0 ? "text-success" : "text-danger")">@spotsLeft / @Model.Capacity</span>
                </div>
                <div class="col-6">
                    <small class="d-block mb-1" style="color: var(--text-secondary);">Duration</small>
                    <span class="fw-bold" style="color: var(--text-main);">60 min</span>
                </div>
            </div>

        </div>
    </div>

    <div class="mb-4">
        <form asp-action="Book" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path">
            @if (isBooked)
            {
                <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill shadow-sm" style="background-color: #FFF0F0; color: #D32F2F; border: none;">
                    <i class="fas fa-times me-2"></i> Отменить запись
                </button>
            }
            else if (spotsLeft <= 0)
            {
                <button class="btn w-100 py-3 fw-bold rounded-pill" style="background-color: #EBEBEB; color: #A0A0A0; border: none;" disabled>
                    Мест нет
                </button>
            }
            else
            {
                <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill shadow-sm" style="background-color: var(--primary-orange); color: white; border: none;">
                    <i class="fas fa-check me-2"></i> Записаться на @Model.StartTime.ToLocalTime().ToString("HH:mm")
                </button>
            }
        </form>
    </div>

    <div style="height: 60px;"></div>
</div>