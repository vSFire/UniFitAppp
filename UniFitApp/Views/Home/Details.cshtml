@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Детали тренировки";
    string currentUserId = ViewBag.CurrentUserId as string;
    bool isBooked = Model.Enrollments.Any(e => e.StudentId == currentUserId);
    int spotsLeft = Model.Capacity - Model.Enrollments.Count;
    var futureSessions = ViewBag.FutureSessions as List<UniFitApp.Models.Workout> ?? new List<UniFitApp.Models.Workout>();

    string videoId = "";
    if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        if (Model.VideoUrl.Contains("youtu.be/"))
        {
            videoId = Model.VideoUrl.Split("youtu.be/")[1].Split("?")[0];
        }
        else if (Model.VideoUrl.Contains("v="))
        {
            videoId = Model.VideoUrl.Split("v=")[1].Split("&")[0];
        }
    }
}

<div class="container pb-5">

    <div class="d-flex align-items-center mb-4 mt-2">
        <a asp-action="Index" class="text-decoration-none me-3 shadow-sm" style="color: var(--text-main); background: #ffffff; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h4 class="fw-bold mb-0" style="color: var(--text-main);">Детали тренировки</h4>
    </div>

    <div class="card border-0 mb-4" style="background-color: var(--bg-card); border-radius: 24px; box-shadow: 0 4px 25px rgba(0,0,0,0.06); overflow: hidden;">

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div style="width: 100%; background-color: #f8f9fa; border-bottom: 1px solid var(--border-light); line-height: 0;">
                <img src="@Model.ImageUrl" alt="@Model.Title" style="width: 100%; height: auto; max-height: 500px; object-fit: contain; display: block;" />
            </div>
        }
        else if (!string.IsNullOrEmpty(videoId))
        {
            <div class="ratio ratio-16x9">
                <iframe src="https://www.youtube.com/embed/@videoId?rel=0" title="YouTube video" allowfullscreen></iframe>
            </div>
        }

        <div class="card-body p-4">

            <h2 class="fw-bold mb-1" style="color: var(--text-main);">@Model.Title</h2>

            <p class="mb-4 mt-3" style="line-height: 1.6; color: var(--text-secondary); font-size: 15px;">
                @(string.IsNullOrEmpty(Model.Description) ? "Описание отсутствует." : Model.Description)
            </p>

            @if (!string.IsNullOrEmpty(Model.ImageUrl) && !string.IsNullOrEmpty(videoId))
            {
                <button type="button" class="btn w-100 rounded-pill mb-4 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#videoModal" style="background-color: #FFF3E0; color: var(--primary-orange); border: none;">
                    <i class="fab fa-youtube me-2"></i> Смотреть видеоинструкцию
                </button>

                <div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-transparent border-0">
                            <div class="modal-header border-0 pb-0 justify-content-end">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div class="ratio ratio-16x9 rounded overflow-hidden shadow-lg">
                                    <iframe src="https://www.youtube.com/embed/@videoId?rel=0" allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-4 pt-3" style="border-top: 1px solid var(--border-light);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" style="color: var(--text-main);">Доступное время</h6>
                    <span class="badge fw-normal" style="background-color: #F0F0F0; color: var(--text-secondary);">Все тренеры</span>
                </div>

                @if (futureSessions.Any())
                {
                    var groupedSessions = futureSessions.GroupBy(s => s.StartTime.Date);

                    foreach (var dayGroup in groupedSessions)
                    {
                        string dayHeader = "";
                        if (dayGroup.Key == DateTime.UtcNow.Date) dayHeader = $"Сегодня, {dayGroup.Key.ToString("dd MMMM")}";
                        else if (dayGroup.Key == DateTime.UtcNow.Date.AddDays(1)) dayHeader = $"Завтра, {dayGroup.Key.ToString("dd MMMM")}";
                        else dayHeader = dayGroup.Key.ToString("dd MMMM, dddd");

                        <div class="mb-3">
                            <div class="small fw-bold mb-2" style="color: var(--text-secondary);">@dayHeader</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var session in dayGroup)
                                {
                                    bool isSessionBooked = session.Enrollments.Any(e => e.StudentId == currentUserId);
                                    bool isSessionFull = (session.Capacity - session.Enrollments.Count) <= 0;

                                    string btnStyle = session.Id == Model.Id ?
                                                                                            "background-color: #FFF3E0; color: var(--primary-orange); border: 1px solid var(--primary-orange); font-weight: bold;"
                                    : "background-color: #F0F0F0; color: var(--text-main); border: 1px solid transparent; font-weight: 500;";

                                    if (isSessionBooked && session.Id != Model.Id) btnStyle = "background-color: #FFF3E0; color: var(--primary-orange); opacity: 0.7; border: none; font-weight: bold;";
                                    else if (isSessionFull && session.Id != Model.Id) btnStyle = "background-color: #F0F0F0; color: #A0A0A0; opacity: 0.5; border: none; pointer-events: none;";

                                    <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm rounded-pill px-3 py-2" style="font-size: 14px; min-width: 75px; @btnStyle">
                                        @session.StartTime.ToLocalTime().ToString("HH:mm")
                                        @if (isSessionBooked)
                                        {
                                            <i class="fas fa-check ms-1" style="font-size: 10px;"></i>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <hr style="border-color: var(--border-light); opacity: 1;">

            <div class="row g-3 mb-2">
                <div class="col-6">
                    <small class="d-block mb-2" style="color: var(--text-secondary);">Тренер</small>
                    @if (Model.Coach != null)
                    {
                        <a asp-action="CoachProfile" asp-route-coachId="@Model.CoachId" class="text-decoration-none d-inline-flex align-items-center px-2 py-1" style="background-color: #FFF3E0; color: var(--primary-orange); border-radius: 8px; font-weight: bold; border: 1px solid rgba(255, 94, 0, 0.2);">
                            <i class="fas fa-user-circle me-2 fs-6"></i>
                            <span>@Model.Coach.FirstName</span>
                        </a>
                    }
                </div>

                <div class="col-6">
                    <small class="d-block mb-1" style="color: var(--text-secondary);">Осталось мест</small>
                    <span class="fw-bold @(spotsLeft > 0 ? "text-success" : "text-danger")">@spotsLeft / @Model.Capacity</span>
                </div>
            </div>

        </div>
    </div>

    <div class="mb-4">
        <form asp-action="Book" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path">
            @if (isBooked)
            {
                <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill shadow-sm" style="background-color: #FFF0F0; color: #D32F2F; border: none;">
                    <i class="fas fa-times me-2"></i> Отменить запись
                </button>
            }
            else if (spotsLeft <= 0)
            {
                <button class="btn w-100 py-3 fw-bold rounded-pill" style="background-color: #EBEBEB; color: #A0A0A0; border: none;" disabled>
                    Мест нет
                </button>
            }
            else
            {
                <button type="submit" class="btn w-100 py-3 fw-bold rounded-pill shadow-sm" style="background-color: var(--primary-orange); color: white; border: none;">
                    <i class="fas fa-check me-2"></i> Записаться на @Model.StartTime.ToLocalTime().ToString("HH:mm")
                </button>












































            }
        </form>
    </div>

    <div style="height: 60px;"></div>
</div>