@model UniFitApp.Models.Workout

@{
    ViewData["Title"] = "Details";
    string currentUserId = ViewBag.CurrentUserId as string;
    bool isBooked = Model.Enrollments.Any(e => e.StudentId == currentUserId);
    int spotsLeft = Model.Capacity - Model.Enrollments.Count;
    var futureSessions = ViewBag.FutureSessions as List<UniFitApp.Models.Workout> ?? new List<UniFitApp.Models.Workout>();

    // Извлекаем ID видео из ссылки YouTube
    string videoId = "";
    if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        if (Model.VideoUrl.Contains("youtu.be/"))
        {
            videoId = Model.VideoUrl.Split("youtu.be/")[1].Split("?")[0];
        }
        else if (Model.VideoUrl.Contains("v="))
        {
            videoId = Model.VideoUrl.Split("v=")[1].Split("&")[0];
        }
    }
}

<div class="container pb-5">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted me-3">
            <i class="fas fa-arrow-left fa-lg"></i>
        </a>
        <h4 class="fw-bold text-white mb-0">Class Details</h4>
    </div>

    @if (!string.IsNullOrEmpty(videoId))
    {
        <div class="ratio ratio-16x9 mb-4 rounded overflow-hidden shadow-lg border border-secondary d-none d-md-block">
            <iframe src="https://www.youtube.com/embed/@videoId?rel=0"
                    title="YouTube video"
                    allowfullscreen></iframe>
        </div>
    }
    else
    {
        <div class="mb-4 rounded d-none d-md-flex align-items-center justify-content-center text-muted border border-secondary"
             style="height: 200px; background-color: #1E1E1E;">
            <div class="text-center">
                <i class="fas fa-video-slash fa-2x mb-2"></i>
                <p class="small mb-0">No preview video available</p>
            </div>
        </div>
    }

    <div class="card border-0 mb-4" style="background-color: #1E1E1E; border-radius: 15px;">
        <div class="card-body p-4">

            <h2 class="fw-bold text-white mb-1">@Model.Title</h2>

            <p class="text-muted mb-3" style="line-height: 1.6;">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided by the coach." : Model.Description)
            </p>

            @if (!string.IsNullOrEmpty(videoId))
            {
                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill mb-4 px-3" data-bs-toggle="modal" data-bs-target="#videoModal">
                    <i class="fas fa-play-circle me-1"></i> Посмотреть видеогид по тренировке
                </button>

                <div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark border-secondary">
                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <div class="ratio ratio-16x9">
                                    <iframe src="https://www.youtube.com/embed/@videoId?rel=0" allowfullscreen></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-4 pt-3 border-top border-secondary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-white fw-bold mb-0">Доступное время</h6>
                    <span class="badge bg-dark text-muted">Все тренеры</span>
                </div>

                @if (futureSessions.Any())
                {
                    // Группируем будущие сеансы по дням
                    var groupedSessions = futureSessions.GroupBy(s => s.StartTime.Date);

                    foreach (var dayGroup in groupedSessions)
                    {
                        string dayHeader = "";
                        if (dayGroup.Key == DateTime.UtcNow.Date) dayHeader = $"Сегодня, {dayGroup.Key.ToString("dd MMMM")}";
                        else if (dayGroup.Key == DateTime.UtcNow.Date.AddDays(1)) dayHeader = $"Завтра, {dayGroup.Key.ToString("dd MMMM")}";
                        else dayHeader = dayGroup.Key.ToString("dd MMMM, dddd");

                        <div class="mb-3">
                            <div class="text-muted small mb-2">@dayHeader</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var session in dayGroup)
                                {
                                    bool isSessionBooked = session.Enrollments.Any(e => e.StudentId == currentUserId);
                                    bool isSessionFull = (session.Capacity - session.Enrollments.Count) <= 0;

                                    // Подсвечиваем активный сеанс (тот, на чьей странице мы сейчас)
                                    string btnClass = session.Id == Model.Id ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-white border-secondary";

                                    if (isSessionBooked && session.Id != Model.Id) btnClass = "btn-warning text-dark opacity-75";
                                    else if (isSessionFull && session.Id != Model.Id) btnClass = "btn-dark text-muted disabled opacity-50";

                                    <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm @btnClass rounded-pill px-3 py-2" style="font-size: 14px; min-width: 75px;">
                                        @session.StartTime.ToLocalTime().ToString("HH:mm")
                                        @if (isSessionBooked)
                                        {
                                            <i class="fas fa-check ms-1" style="font-size: 10px;"></i>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">Нет других доступных сеансов.</p>
                }
            </div>

            <hr class="border-secondary opacity-50">

            <div class="row g-3 mb-2">
                <div class="col-6">
                    <small class="text-muted d-block">Coach</small>
                    <span class="text-white fw-bold"><i class="fas fa-user me-1 text-warning"></i> @(Model.Coach?.FirstName ?? "Unknown")</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Location</small>
                    <span class="text-white fw-bold"><i class="fas fa-map-pin me-1 text-warning"></i> @Model.Location</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Spots Left</small>
                    <span class="@(spotsLeft > 0 ? "text-success" : "text-danger") fw-bold">@spotsLeft / @Model.Capacity</span>
                </div>
                <div class="col-6">
                    <small class="text-muted d-block">Duration</small>
                    <span class="text-white">60 min</span>
                </div>
            </div>

        </div>
    </div>

    <div class="fixed-bottom p-3" style="background: linear-gradient(to top, #000 80%, transparent); pointer-events: none; z-index: 1000;">
        <div class="container" style="pointer-events: auto;">
            <form asp-action="Book" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path">
                @if (isBooked)
                {
                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-pill shadow-lg">
                        <i class="fas fa-times me-2"></i> Отменить запись
                    </button>
                }
                else if (spotsLeft <= 0)
                {
                    <button class="btn btn-secondary w-100 py-3 fw-bold rounded-pill" disabled>
                        Мест нет
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-lg" style="background-color: var(--primary-orange); border: none;">
                        <i class="fas fa-check me-2"></i> Записаться на @Model.StartTime.ToLocalTime().ToString("HH:mm")
                    </button>
                }
            </form>
        </div>
    </div>
    <div style="height: 60px;"></div>
</div>