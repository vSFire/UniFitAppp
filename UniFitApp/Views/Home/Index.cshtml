@using Microsoft.AspNetCore.Identity
@using UniFitApp.Models
@using UniFitApp.Controllers
@inject UserManager<AppUser> UserManager
@model IEnumerable<WorkoutGroupViewModel>

@{
    ViewData["Title"] = "Schedule";
    var currentUser = await UserManager.GetUserAsync(User);
    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.UtcNow.Date;
    var showBookedOnly = ViewBag.ShowBookedOnly as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="card mb-4 border-0 w-100 me-3" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
        <div class="card-body p-3">
            <form method="get" asp-action="Index">
                <input type="hidden" name="date" value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="showBookedOnly" value="@(ViewBag.ShowBookedOnly.ToString().ToLower())" />

                <div class="row g-2">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text" style="background-color: var(--bg-main); border: 1px solid var(--border-light); border-right: none; color: var(--text-secondary);"><i class="fas fa-search"></i></span>
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                                   class="form-control"
                                   style="background-color: var(--bg-main); border: 1px solid var(--border-light); border-left: none; color: var(--text-main);"
                                   placeholder="Поиск направления...">
                        </div>
                    </div>

                    <div class="col-6">
                        <select name="workoutType" class="form-select" style="background-color: var(--bg-main); border: 1px solid var(--border-light); color: var(--text-main);" onchange="this.form.submit()">
                            <option value="">Все типы</option>
                            <option value="Cardio" selected="@(ViewBag.CurrentType == "Cardio")">Cardio</option>
                            <option value="Strength" selected="@(ViewBag.CurrentType == "Strength")">Strength</option>
                            <option value="Yoga" selected="@(ViewBag.CurrentType == "Yoga")">Yoga</option>
                            <option value="Boxing" selected="@(ViewBag.CurrentType == "Boxing")">Boxing</option>
                            <option value="CrossFit" selected="@(ViewBag.CurrentType == "CrossFit")">CrossFit</option>
                        </select>
                    </div>

                    <div class="col-6">
                        <select name="timeOfDay" class="form-select" style="background-color: var(--bg-main); border: 1px solid var(--border-light); color: var(--text-main);" onchange="this.form.submit()">
                            <option value="">Любое время</option>
                            <option value="Morning" selected="@(ViewBag.CurrentTime == "Morning")">Утро (до 12)</option>
                            <option value="Afternoon" selected="@(ViewBag.CurrentTime == "Afternoon")">День (12-17)</option>
                            <option value="Evening" selected="@(ViewBag.CurrentTime == "Evening")">Вечер (после 17)</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentType) || !string.IsNullOrEmpty(ViewBag.CurrentTime))
                    {
                        <div class="col-12 mt-2">
                            <a asp-action="Index" asp-route-date="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" class="btn btn-sm w-100 fw-bold" style="background-color: #F0F0F0; color: var(--text-main); border-radius: 8px;">
                                <i class="fas fa-times me-1"></i> Сбросить фильтры
                            </a>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<div class="mb-4">
    <h2 class="fw-bold mb-0" style="color: var(--text-main); font-size: 28px;">Расписание</h2>
    @if (showBookedOnly)
    {
        <p class="mb-0 fw-bold" style="color: var(--primary-orange);">Мои записи</p>
    }
    else
    {
        <p class="mb-0" style="color: var(--text-secondary);">@selectedDate.ToLocalTime().ToString("MMMM dd, yyyy")</p>
    }
</div>

<div class="d-flex justify-content-between overflow-auto mb-4 pb-2" style="gap: 10px; @(showBookedOnly ? "opacity: 0.5; pointer-events: none;" : "")">
    @{
        var today = DateTime.UtcNow.Date;
    }
    @for (int i = 0; i < 7; i++)
    {
        var day = today.AddDays(i);
        var isActive = day.Date == selectedDate.Date;

        <a asp-action="Index"
           asp-route-date="@day.ToString("yyyy-MM-dd")"
           asp-route-showBookedOnly="false"
           class="text-decoration-none text-center p-2 flex-fill"
           style="min-width: 65px; border-radius: 16px; transition: 0.3s;
                      background-color: @(isActive ? "var(--bg-card)" : "transparent");
                      border: @(isActive ? "2px solid var(--primary-orange)" : "1px solid transparent");
                      box-shadow: @(isActive ? "0 4px 10px rgba(0,0,0,0.05)" : "none");">
            <div class="small fw-bold text-uppercase" style="color: @(isActive ? "var(--primary-orange)" : "var(--text-secondary)");">@day.ToString("ddd")</div>
            <div class="fs-4 fw-bold" style="color: @(isActive ? "var(--text-main)" : "var(--text-secondary)");">@day.Day</div>
        </a>
    }
</div>

<div class="d-flex mb-4 p-1" style="background-color: #EBEBEB; border-radius: 12px; max-width: 300px;">
    <a asp-action="Index" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" asp-route-showBookedOnly="false"
       class="flex-fill btn btn-sm rounded fw-bold"
       style="background-color: @(!showBookedOnly ? "var(--bg-card)" : "transparent");
              color: @(!showBookedOnly ? "var(--text-main)" : "var(--text-secondary)");
              box-shadow: @(!showBookedOnly ? "0 2px 5px rgba(0,0,0,0.05)" : "none"); border: none;">
        Все занятия
    </a>
    <a asp-action="Index" asp-route-showBookedOnly="true"
       class="flex-fill btn btn-sm rounded fw-bold"
       style="background-color: @(showBookedOnly ? "var(--bg-card)" : "transparent");
              color: @(showBookedOnly ? "var(--text-main)" : "var(--text-secondary)");
              box-shadow: @(showBookedOnly ? "0 2px 5px rgba(0,0,0,0.05)" : "none"); border: none;">
        Мои записи
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5" style="color: var(--text-secondary);">
        <i class="fas fa-dumbbell fa-3x mb-3" style="opacity: 0.3;"></i>
        <p>@(showBookedOnly ? "У вас пока нет записей." : "На этот день тренировок не запланировано.")</p>
    </div>
}
else
{
    @foreach (var group in Model)
    {
        <div class="card mb-3 border-0" style="background-color: var(--bg-card); border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h4 class="fw-bold mb-1" style="color: var(--text-main);">@group.Title</h4>
                        <p class="small mb-0" style="color: var(--text-secondary); line-height: 1.4;">
                            @(string.IsNullOrEmpty(group.Description) ? "Описание отсутствует" : group.Description)
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var session in group.Sessions)
                    {
                        bool isBooked = currentUser != null && session.Enrollments.Any(e => e.StudentId == currentUser.Id);
                        int spotsLeft = session.Capacity - session.Enrollments.Count;
                        bool isFull = spotsLeft <= 0;

                        string btnStyle = "background-color: #F0F0F0; color: var(--text-main); border: none;"; // Обычный
                        if (isBooked)
                        {
                            btnStyle = "background-color: #FFF3E0; color: var(--primary-orange); border: 1px solid var(--primary-orange); font-weight: bold;"; // Записан
                        }
                        else if (isFull)
                        {
                            btnStyle = "background-color: #F0F0F0; color: #A0A0A0; border: none; opacity: 0.6; pointer-events: none;"; // Мест нет
                        }

                        <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm rounded-pill px-3 py-2 fw-bold" style="font-size: 14px; min-width: 75px; @btnStyle">
                            @session.StartTime.ToLocalTime().ToString("HH:mm")
                            @if (isBooked)
                            {
                                <i class="fas fa-check ms-1" style="font-size: 10px;"></i>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}
<div style="height: 80px;"></div>