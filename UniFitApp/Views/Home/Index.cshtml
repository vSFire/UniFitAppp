@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Schedule";
    var currentUser = await UserManager.GetUserAsync(User);

    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.UtcNow.Date;
    var showBookedOnly = ViewBag.ShowBookedOnly as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-white mb-0">Schedule</h2>
        @if (showBookedOnly)
        {
            <p class="text-warning mb-0">My Booked Classes</p>
        }
        else
        {
            <p class="text-muted mb-0">@selectedDate.ToLocalTime().ToString("MMMM dd, yyyy")</p>
        }
    </div>

    <a asp-controller="Account" asp-action="Notifications" class="btn btn-dark rounded-circle border-secondary position-relative" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
        <i class="fas fa-bell text-white"></i>
    </a>
</div>

<div class="d-flex justify-content-between overflow-auto mb-4 pb-2" style="@(showBookedOnly ? "opacity: 0.5; pointer-events: none;" : "")">
    @{
        var today = DateTime.UtcNow.Date;
    }
    @for (int i = 0; i < 7; i++)
    {
        var day = today.AddDays(i);
        var isActive = day.Date == selectedDate.Date;

        <a asp-action="Index"
           asp-route-date="@day.ToString("yyyy-MM-dd")"
           asp-route-showBookedOnly="false"
           class="text-decoration-none text-center rounded p-2 mx-1 flex-fill @(isActive ? "bg-warning text-dark" : "bg-dark text-muted")"
           style="min-width: 60px; border: 1px solid #333;">
            <div class="small fw-bold">@day.ToString("ddd")</div>
            <div class="fs-4 fw-bold">@day.Day</div>
        </a>
    }
</div>

<div class="d-flex mb-4 bg-dark rounded p-1 border border-secondary" style="max-width: 300px;">
    <a asp-action="Index" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" asp-route-showBookedOnly="false"
       class="flex-fill btn btn-sm rounded fw-bold @(!showBookedOnly ? "bg-warning text-dark" : "text-muted")">
        All Classes
    </a>
    <a asp-action="Index" asp-route-showBookedOnly="true"
       class="flex-fill btn btn-sm rounded fw-bold @(showBookedOnly ? "bg-warning text-dark" : "text-muted")">
        Booked
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="fas fa-dumbbell fa-3x mb-3" style="opacity: 0.3;"></i>
        <p>@(showBookedOnly ? "You haven't booked any classes yet." : "No classes scheduled.")</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        int spotsLeft = item.Capacity - item.Enrollments.Count;
        bool isFull = spotsLeft <= 0;
        bool isBooked = currentUser != null && item.Enrollments.Any(e => e.StudentId == currentUser.Id);

        <div class="card mb-3 border-0" style="background-color: #1E1E1E; border-radius: 15px; border-left: 5px solid var(--primary-orange) !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted mb-1">
                            @item.StartTime.ToLocalTime().ToString("hh:mm tt")
                            @if (showBookedOnly)
                            {
                                <span class="badge bg-dark text-muted ms-2">@item.StartTime.ToLocalTime().ToString("dd MMM")</span>
                            }
                        </div>
                        <h5 class="card-title text-white fw-bold mb-1">@item.Title</h5>
                        <div class="small text-muted mb-2">
                            <i class="fas fa-user-circle me-1"></i> Coach @(item.Coach?.FirstName ?? "Unknown")
                        </div>
                        <div class="small text-muted">
                            <i class="fas fa-map-marker-alt me-1"></i> @item.Location
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end">
                        @if (!isBooked)
                        {
                            <span class="badge bg-dark border border-warning text-warning mb-3">@(isFull ? "FULL" : $"{spotsLeft} SPOTS")</span>
                        }

                        @if (isBooked)
                        {
                            <button class="btn btn-success btn-sm px-4 fw-bold" disabled>Booked <i class="fas fa-check"></i></button>
                        }
                        else if (isFull)
                        {
                            <button class="btn btn-secondary btn-sm px-4 fw-bold" disabled>Waitlist</button>
                        }
                        else
                        {
                            <form asp-action="Book" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold text-white">Book</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
<div style="height: 80px;"></div>