@using Microsoft.AspNetCore.Identity
@using UniFitApp.Models
@using UniFitApp.Controllers
@inject UserManager<AppUser> UserManager
@model IEnumerable<WorkoutGroupViewModel>

@{
    ViewData["Title"] = "Schedule";
    var currentUser = await UserManager.GetUserAsync(User);

    var selectedDate = ViewBag.SelectedDate as DateTime? ?? DateTime.UtcNow.Date;
    var showBookedOnly = ViewBag.ShowBookedOnly as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="card mb-4 border-0 w-100 me-3" style="background-color: #1E1E1E; border-radius: 15px;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index">
                <input type="hidden" name="date" value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="showBookedOnly" value="@(ViewBag.ShowBookedOnly.ToString().ToLower())" />

                <div class="row g-2">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                                   class="form-control bg-dark text-white border-secondary"
                                   placeholder="Поиск направления...">
                        </div>
                    </div>

                    <div class="col-6">
                        <select name="workoutType" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                            <option value="">Все типы</option>
                            <option value="Cardio" selected="@(ViewBag.CurrentType == "Cardio")">Cardio</option>
                            <option value="Strength" selected="@(ViewBag.CurrentType == "Strength")">Strength</option>
                            <option value="Yoga" selected="@(ViewBag.CurrentType == "Yoga")">Yoga</option>
                            <option value="Boxing" selected="@(ViewBag.CurrentType == "Boxing")">Boxing</option>
                            <option value="CrossFit" selected="@(ViewBag.CurrentType == "CrossFit")">CrossFit</option>
                        </select>
                    </div>

                    <div class="col-6">
                        <select name="timeOfDay" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                            <option value="">Любое время</option>
                            <option value="Morning" selected="@(ViewBag.CurrentTime == "Morning")">Утро (до 12)</option>
                            <option value="Afternoon" selected="@(ViewBag.CurrentTime == "Afternoon")">День (12-17)</option>
                            <option value="Evening" selected="@(ViewBag.CurrentTime == "Evening")">Вечер (после 17)</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || !string.IsNullOrEmpty(ViewBag.CurrentType) || !string.IsNullOrEmpty(ViewBag.CurrentTime))
                    {
                        <div class="col-12">
                            <a asp-action="Index" asp-route-date="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="fas fa-times me-1"></i> Сбросить фильтры
                            </a>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <h2 class="fw-bold text-white mb-0">Расписание</h2>
    @if (showBookedOnly)
    {
        <p class="text-warning mb-0">Мои записи</p>
    }
    else
    {
        <p class="text-muted mb-0">@selectedDate.ToLocalTime().ToString("MMMM dd, yyyy")</p>
    }
</div>

<div class="d-flex justify-content-between overflow-auto my-4 pb-2" style="@(showBookedOnly ? "opacity: 0.5; pointer-events: none;" : "")">
    @{
        var today = DateTime.UtcNow.Date;
    }
    @for (int i = 0; i < 7; i++)
    {
        var day = today.AddDays(i);
        var isActive = day.Date == selectedDate.Date;

        <a asp-action="Index"
           asp-route-date="@day.ToString("yyyy-MM-dd")"
           asp-route-showBookedOnly="false"
           class="text-decoration-none text-center rounded p-2 mx-1 flex-fill @(isActive ? "bg-warning text-dark" : "bg-dark text-muted")"
           style="min-width: 65px; border: 1px solid #333;">
            <div class="small fw-bold text-uppercase">@day.ToString("ddd")</div>
            <div class="fs-4 fw-bold">@day.Day</div>
        </a>
    }
</div>

<div class="d-flex mb-4 bg-dark rounded p-1 border border-secondary" style="max-width: 300px;">
    <a asp-action="Index" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" asp-route-showBookedOnly="false"
       class="flex-fill btn btn-sm rounded fw-bold @(!showBookedOnly ? "bg-warning text-dark" : "text-muted")">
        Все занятия
    </a>
    <a asp-action="Index" asp-route-showBookedOnly="true"
       class="flex-fill btn btn-sm rounded fw-bold @(showBookedOnly ? "bg-warning text-dark" : "text-muted")">
        Мои записи
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="fas fa-dumbbell fa-3x mb-3" style="opacity: 0.3;"></i>
        <p>@(showBookedOnly ? "У вас пока нет записей." : "На этот день тренировок не запланировано.")</p>
    </div>
}
else
{
    @foreach (var group in Model)
    {
        <div class="card mb-3 border-0" style="background-color: #1E1E1E; border-radius: 20px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h4 class="text-white fw-bold mb-1">@group.Title</h4>
                        <p class="text-muted small mb-0" style="line-height: 1.4;">
                            @(string.IsNullOrEmpty(group.Description) ? "Описание отсутствует" : group.Description)
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var session in group.Sessions)
                    {
                        bool isBooked = currentUser != null && session.Enrollments.Any(e => e.StudentId == currentUser.Id);
                        int spotsLeft = session.Capacity - session.Enrollments.Count;
                        bool isFull = spotsLeft <= 0;

                        // Настраиваем дизайн кнопки в зависимости от статуса
                        string btnClass = "btn-outline-secondary text-white border-secondary"; // Обычный слот
                        if (isBooked)
                        {
                            btnClass = "btn-warning text-dark fw-bold"; // Записан
                        }
                        else if (isFull)
                        {
                            btnClass = "btn-dark text-muted border-dark disabled opacity-50"; // Мест нет
                        }

                        <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-sm @btnClass rounded-pill px-3 py-2" style="font-size: 14px; min-width: 75px;">
                            @session.StartTime.ToLocalTime().ToString("HH:mm")
                            @if (isBooked)
                            {
                                <i class="fas fa-check ms-1" style="font-size: 10px;"></i>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}
<div style="height: 80px;"></div>