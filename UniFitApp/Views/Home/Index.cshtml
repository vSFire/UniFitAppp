@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model IEnumerable<UniFitApp.Models.Workout>

@{
    ViewData["Title"] = "Расписание";
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-white mb-0">Fitness Schedule</h4>
        <small class="text-muted">University Gym Center</small>
    </div>
    <div class="rounded-circle bg-dark p-2">
        <i class="fas fa-bell text-white"></i>
    </div>
</div>

<div class="d-flex justify-content-between overflow-auto mb-4 pb-2">
    @{
        var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
        var today = DateTime.Today;
    }

    @for (int i = 0; i < 7; i++)
    {
        var day = today.AddDays(i);
        var isActive = day.Date == selectedDate.Date;

        <a asp-action="Index" asp-route-date="@day.ToString("yyyy-MM-dd")"
           class="text-decoration-none text-center rounded p-2 mx-1 flex-fill @(isActive ? "bg-warning text-dark" : "bg-dark text-muted")"
           style="min-width: 60px; border: 1px solid #333;">

            <div class="small fw-bold">@day.ToString("ddd")</div>
            <div class="fs-4 fw-bold">@day.Day</div>
        </a>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="text-white fw-bold">Today's Classes</h5>
    <div>
        <span class="badge bg-warning text-dark me-1">ALL</span>
        <span class="badge bg-dark border border-secondary text-muted">BOOKED</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="fas fa-dumbbell fa-3x mb-3" style="opacity: 0.3;"></i>
        <p>На сегодня тренировок нет.</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        // Считаем места
        int spotsLeft = item.Capacity - item.Enrollments.Count;
        bool isFull = spotsLeft <= 0;

        // Проверяем, записан ли уже этот студент
        bool isBooked = currentUser != null && item.Enrollments.Any(e => e.StudentId == currentUser.Id);

        <div class="card mb-3 border-0" style="background-color: #1E1E1E; border-radius: 15px; border-left: 5px solid var(--primary-orange) !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-muted mb-1">
                            @item.StartTime.ToString("hh:mm tt")
                        </div>

                        <h5 class="card-title text-white fw-bold mb-1">@item.Title</h5>

                        <div class="small text-muted mb-2 d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(item.Coach?.ProfilePictureUrl))
                            {
                                <img src="@item.Coach.ProfilePictureUrl"
                                     alt="Coach"
                                     class="rounded-circle me-2"
                                     style="width: 24px; height: 24px; object-fit: cover; border: 1px solid var(--primary-orange);">
                            }
                            else
                            {
                                <i class="fas fa-user-circle me-2"></i>
                            }

                            <span>Coach @(item.Coach?.FirstName ?? "Unknown")</span>
                        </div>

                        <div class="small text-muted">
                            <i class="fas fa-map-marker-alt me-1"></i> @item.Location
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end">
                        @if (isFull)
                        {
                            <span class="badge bg-secondary mb-3">FULL</span>
                        }
                        else
                        {
                            <span class="badge bg-dark border border-warning text-warning mb-3">@spotsLeft SPOTS LEFT</span>
                        }

                        @if (isBooked)
                        {
                            <button class="btn btn-success btn-sm px-4 fw-bold" disabled>Booked <i class="fas fa-check"></i></button>
                        }
                        else if (isFull)
                        {
                            <button class="btn btn-secondary btn-sm px-4 fw-bold" disabled>Waitlist</button>
                        }
                        else
                        {
                            <form asp-action="Book" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold text-white">Book</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
<div style="height: 80px;"></div>