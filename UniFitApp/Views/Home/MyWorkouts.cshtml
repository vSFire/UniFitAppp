@model IEnumerable<UniFitApp.Models.Enrollment>

@{
    ViewData["Title"] = "Мои записи";
    var upcoming = Model.Where(e => e.Workout.StartTime > DateTime.UtcNow).ToList();
    var history = Model.Where(e => e.Workout.StartTime <= DateTime.UtcNow).ToList();
}

<div class="d-flex align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color: var(--text-main); font-size: 28px;">Мои записи</h4>
</div>

<style>
    .nav-pills .nav-link.active {
        background-color: var(--bg-card) !important;
        color: var(--text-main) !important;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .nav-pills .nav-link {
        color: var(--text-secondary);
    }

    .clickable-workout:hover {
        opacity: 0.8;
    }
</style>

<ul class="nav nav-pills mb-4 nav-justified" style="background: #EBEBEB; border-radius: 12px; padding: 5px;">
    <li class="nav-item">
        <a class="nav-link active rounded-3 fw-bold" data-bs-toggle="pill" href="#upcoming">Предстоящие</a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-3 fw-bold" data-bs-toggle="pill" href="#history">История</a>
    </li>
</ul>

<div class="tab-content">

    <div class="tab-pane fade show active" id="upcoming">
        @if (!upcoming.Any())
        {
            <div class="text-center mt-5" style="color: var(--text-secondary);">
                <i class="fas fa-calendar-times fa-3x mb-3" style="opacity: 0.3;"></i>
                <p>Вы пока никуда не записаны.</p>
                <a asp-action="Index" class="btn btn-sm fw-bold" style="background-color: #FFF3E0; color: var(--primary-orange); border-radius: 10px;">Перейти к расписанию</a>
            </div>
        }
        else
        {
            @foreach (var item in upcoming)
            {
                <div class="card mb-3 border-0" style="background-color: var(--bg-card); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light);">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="Details" asp-route-id="@item.Workout.Id" class="text-decoration-none flex-grow-1 clickable-workout">
                                <h5 class="fw-bold mb-1" style="color: var(--text-main);">
                                    @item.Workout.Title
                                    <i class="fas fa-chevron-right ms-1" style="font-size: 12px; color: var(--border-light);"></i>
                                </h5>
                                <div class="small fw-bold mb-2" style="color: var(--primary-orange);">
                                    <i class="far fa-clock me-1"></i> @item.Workout.StartTime.ToLocalTime().ToString("f")
                                </div>
                                <div class="small" style="color: var(--text-secondary);">
                                    <i class="fas fa-map-marker-alt me-1"></i> @item.Workout.Location
                                </div>
                            </a>

                            <div class="ms-3">
                                <form asp-action="CancelBooking" asp-route-workoutId="@item.Workout.Id" method="post" onsubmit="return confirm('Отменить запись?');">
                                    <button type="submit" class="btn btn-sm fw-bold" style="background-color: #FFF0F0; color: #D32F2F; border-radius: 10px; border: none;">
                                        <i class="fas fa-times"></i> Отменить
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="tab-pane fade" id="history">
        @if (!history.Any())
        {
            <div class="text-center mt-5" style="color: var(--text-secondary);">
                <p>История пуста.</p>
            </div>
        }
        else
        {
            @foreach (var item in history)
            {
                <a asp-action="Details" asp-route-id="@item.Workout.Id" class="text-decoration-none clickable-workout">
                    <div class="card mb-3 border-0" style="background-color: #F7F7F7; border-radius: 16px; border: 1px solid var(--border-light);">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1" style="color: var(--text-main);">@item.Workout.Title</h6>
                                <small style="color: var(--text-secondary);">@item.Workout.StartTime.ToLocalTime().ToString("d MMMM yyyy")</small>
                            </div>
                            <span class="badge fw-normal" style="background-color: #EBEBEB; color: var(--text-secondary);">Завершено</span>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</div>

<div style="height: 80px;"></div>