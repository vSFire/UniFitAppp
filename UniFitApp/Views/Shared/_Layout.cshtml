@using Microsoft.AspNetCore.Identity
@using UniFitApp.Models
@inject UserManager<AppUser> UserManager

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <nav class="navbar navbar-light mb-3 shadow-sm" style="background-color: var(--bg-card); border-bottom: 1px solid var(--border-light);">
        <div class="container-fluid px-4 d-flex justify-content-between justify-content-lg-end align-items-center">

            <a class="navbar-brand d-flex d-lg-none align-items-center py-1" href="/">
                <img src="~/images/logo.png" alt="UniFit" style="height: 50px; margin-right: 12px; object-fit: contain;">
                <span class="fw-bold fs-3" style="color: var(--text-main); letter-spacing: 0.5px;">UniFit</span>
            </a>

            @if (User.Identity.IsAuthenticated)
            {
                var currentUser = await UserManager.GetUserAsync(User);
                var userInitial = "U";
                if (currentUser != null && !string.IsNullOrEmpty(currentUser.FirstName))
                {
                    userInitial = currentUser.FirstName.Substring(0, 1).ToUpper();
                }

                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Account" asp-action="Notifications" class="text-decoration-none position-relative" style="color: var(--text-main);">
                        <i class="fa-regular fa-bell" style="font-size: 24px;"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 rounded-circle" style="background-color: var(--accent-light); width: 12px; height: 12px; border: 2px solid var(--bg-card);">
                            <span class="visually-hidden">New alerts</span>
                        </span>
                    </a>

                    <a asp-controller="Account" asp-action="Profile" class="text-decoration-none">
                        @if (currentUser != null && !string.IsNullOrEmpty(currentUser.ProfilePictureUrl))
                        {
                            <img src="@currentUser.ProfilePictureUrl"
                                 alt="Avatar"
                                 class="rounded-circle shadow-sm"
                                 style="width: 45px; height: 45px; object-fit: cover; border: 2px solid var(--accent-light);">
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 45px; height: 45px; border: 2px solid var(--accent-light); background-color: rgba(110, 126, 94, 0.1);">
                                <span class="fw-bold fs-5" style="color: var(--accent-dark);">@userInitial</span>
                            </div>
                        }
                    </a>
                </div>
            }
        </div>
    </nav>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity.IsAuthenticated)
    {
        string c = ViewContext.RouteData.Values["Controller"]?.ToString();
        string a = ViewContext.RouteData.Values["Action"]?.ToString();

        bool isCoach = User.IsInRole("Coach");
        bool isAdmin = User.IsInRole("Admin");

        <nav class="bottom-nav">

            <a class="d-none d-lg-flex align-items-center mb-5 w-100 px-3 py-2 shadow-sm" href="/" style="text-decoration: none; background-color: var(--bg-card); border-radius: 16px;">
                <img src="~/images/logo.png" alt="UniFit" style="height: 45px; margin-right: 12px; object-fit: contain;">
                <span class="fw-bold fs-3" style="color: var(--text-main); letter-spacing: 0.5px;">UniFit</span>
            </a>
            @if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="Users" class="nav-item @(c == "Admin" && a == "Users" ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Пользователи</span>
                </a>
                <a asp-controller="Admin" asp-action="Workouts" class="nav-item @(c == "Admin" && a == "Workouts" ? "active" : "")">
                    <i class="fas fa-list"></i>
                    <span>Все занятия</span>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="nav-item @(c == "Account" && a == "Profile" ? "active" : "")">
                    <i class="fas fa-user-shield"></i>
                    <span>Профиль</span>
                </a>
            }
            else
            {
                @if (isCoach)
                {
                    <a asp-controller="Coach" asp-action="Index" class="nav-item @(c == "Coach" && a == "Index" ? "active" : "")">
                        <i class="fas fa-th-large"></i>
                        <span>Главная</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index" class="nav-item @(c == "Home" && a == "Index" ? "active" : "")">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Расписание</span>
                    </a>
                }

                @if (isCoach)
                {
                    <a asp-controller="Coach" asp-action="Students" class="nav-item @(c == "Coach" && a == "Students" ? "active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Пользователи</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Attendance" class="nav-item @(c == "Home" && a == "Attendance" ? "active" : "")">
                        <i class="fas fa-qrcode"></i>
                        <span>Доступ</span>
                    </a>
                }

                @if (isCoach)
                {
                    <div class="nav-item-center">
                        <a asp-controller="Coach" asp-action="Create" class="text-decoration-none" title="Создать тренировку">
                            <div class="plus-btn"><i class="fas fa-plus"></i></div>
                        </a>
                    </div>
                }

                @if (isCoach)
                {
                    <a asp-controller="Coach" asp-action="AllWorkouts" class="nav-item @(c == "Coach" && a == "AllWorkouts" ? "active" : "")">
                        <i class="fas fa-dumbbell"></i>
                        <span>Тренировки</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="MyWorkouts" class="nav-item @(c == "Home" && a == "MyWorkouts" ? "active" : "")">
                        <i class="fas fa-dumbbell"></i>
                        <span>Мои записи</span>
                    </a>
                }

                <a asp-controller="Account" asp-action="Profile" class="nav-item @(c == "Account" && a == "Profile" ? "active" : "")">
                    <i class="fas fa-user"></i>
                    <span>Профиль</span>
                </a>
            }
        </nav>
    }
</body>
</html>