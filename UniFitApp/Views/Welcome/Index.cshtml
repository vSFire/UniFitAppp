@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@model UniFitApp.Models.AppUser

@{
    ViewData["Title"] = "Welcome";
    bool isCoach = false;
    if (Model != null)
    {
        isCoach = await UserManager.IsInRoleAsync(Model, "Coach");
    }
}

<div class="container-fluid px-0 mb-5">

    <div class="position-relative text-center text-white mb-5">

        <div class="position-absolute w-100 h-100 d-flex flex-column justify-content-center align-items-center"
             style="z-index: 10; background: rgba(0, 0, 0, 0.5); top: 0; left: 0;">

            <h1 class="display-4 fw-bold mb-3">Добро пожаловать, <span style="color: var(--primary-orange);">@(Model?.FirstName ?? "User")!</span></h1>
            <p class="lead mb-4">Твой путь к совершенству начинается в UniFit.</p>

            @if (isCoach)
            {
                <a asp-controller="Coach" asp-action="Index" class="btn btn-warning btn-lg px-5 py-3 fw-bold rounded-pill shadow">
                    <i class="fas fa-th-large me-2"></i> Перейти в Дашборд
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-lg px-5 py-3 fw-bold rounded-pill shadow">
                    <i class="fas fa-calendar-alt me-2"></i> Смотреть Расписание
                </a>
            }
        </div>

        <div id="gymCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner" style="height: 600px;">
                <div class="carousel-item active h-100">
                    <div class="w-100 h-100" style="background: url('/images/welcome/1.png') center/cover no-repeat;"></div>
                </div>
                <div class="carousel-item h-100">
                    <div class="w-100 h-100" style="background: url('/images/welcome/2.png') center/cover no-repeat;"></div>
                </div>
                <div class="carousel-item h-100">
                    <div class="w-100 h-100" style="background: url('/images/welcome/3.png') center/cover no-repeat;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="background-color: #1E1E1E; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><i class="fas fa-map-marker-alt fa-3x text-secondary"></i></div>
                        <h5 class="text-white fw-bold">Где нас найти</h5>
                        <p class="text-muted small">Университетский кампус, Корпус Б.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="background-color: #1E1E1E; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><i class="fas fa-dumbbell fa-3x text-secondary"></i></div>
                        <h5 class="text-white fw-bold">Наши Тренеры</h5>
                        <p class="text-muted small">Профессионалы своего дела.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="background-color: #1E1E1E; border-radius: 15px;">
                    <div class="card-body text-center p-4">
                        <div class="mb-3"><i class="fas fa-bullhorn fa-3x text-secondary"></i></div>
                        <h5 class="text-white fw-bold">Новости</h5>
                        <p class="text-muted small">Новое оборудование уже доступно!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>